# =====================================================================
# VoiceBack Production Backend Environment Configuration Template
# Placeholders only - Never commit real credentials to source control.
# =====================================================================

# Server & Network Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Frontend Origin for CORS (comma-separated for multiple origins, e.g., https://voiceback.vercel.app,http://localhost:5173)
CLIENT_ORIGIN=https://your-voiceback-frontend.vercel.app

# Database Configuration (MongoDB Atlas TLS Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/voiceback?retryWrites=true&w=majority

# Optional: Isolated Test Database URI (strictly required only when running automated tests)
# TEST_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/voiceback_test?retryWrites=true&w=majority

# Authentication Security (Cryptographically strong secret)
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters

# Google Gemini AI (Context Engine & Speech Reconstruction)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=4000

# Cartesia AI (Patient Cloned Voice Synthesis & TTS)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_VERSION=2026-08-14

# ElevenLabs (Scribe v2 STT Speech-to-Text & Fallback TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL
